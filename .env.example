# ===== Авторизация author.today (необязательно) =====
#
# Скопируйте этот файл в .env и заполните, если хотите проверять не только
# бесплатные главы. Для книги, купленной с этого аккаунта (или открытой подпиской),
# главы в оглавлении перестают быть «закрытыми» и парсятся наравне с бесплатными.
#
# .env в .gitignore — не публикуйте его вместе с проектом.
# Если файла .env нет или поля пустые, программа работает анонимно, как раньше.
#
# Внимание: аккаунты с 2FA не поддерживаются — код из письма вводить здесь негде.

AT_LOGIN=
AT_PASSWORD=

# Необязательно: свой зеркало/адрес, если стандартный не подходит.
# AT_BASE_URL=https://author.today
